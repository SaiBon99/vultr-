# Copy to .env and fill it in your editor. Never commit .env and never paste values into chat.
# Build for the VM with PUBLIC_API_MODE=live PUBLIC_API_BASE=/ (same origin, see infra/scripts/publish.sh).
# Leave PUBLIC_API_BASE empty for local dev against http://localhost:8000.
PUBLIC_API_MODE=mock
PUBLIC_API_BASE=http://localhost:8000
# Live mode only; leave blank to use the in-app token field.
PUBLIC_REVIEWER_TOKEN=
