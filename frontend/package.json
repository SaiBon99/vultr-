{
  "name": "memory-quarantine-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "api:types": "openapi-typescript ../contracts/openapi.yaml -o src/lib/api/schema.d.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:unified": "node .agents/skills/frontend/scripts/check.mjs",
    "check:full": "node .agents/skills/frontend/scripts/check.mjs --full",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test smoke",
    "test:a11y": "playwright test a11y",
    "test:visual": "playwright test visual",
    "test:visual:update": "playwright test visual --update-snapshots",
    "record:check": "cd .. && node .agents/skills/close-session/record_check.mjs",
    "tokens:build": "tz build && node tokens/tools/fluid.mjs && node tokens/tools/stamp.mjs",
    "tokens:check": "node tokens/tools/stamp.mjs --check && tz check",
    "docs:regen": "node .agents/skills/frontend/scripts/docs.mjs regen"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "1.65.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@terrazzo/cli": "^2.10.0",
    "@terrazzo/plugin-css": "^2.10.0",
    "@terrazzo/plugin-tailwind": "^2.10.0",
    "@types/node": "^26.6.11",
    "eslint": "^10.15.0",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "1.65.0",
    "prettier": "^3.10.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@ark-ui/svelte": "^5.25.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lucide/svelte": "^1.81.0",
    "tailwindcss": "^4.3.5"
  }
}
