# Copy to .env (gitignored) and fill in. Never commit real keys.

# Vultr Serverless Inference (OpenAI-compatible). Worker and judge are separate models.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Worker model. Pick a live ID from https://api.vultrinference.com/v1/models
VULTR_INFERENCE_MODEL=
# Judge model: explains frozen writes. Use a different family from the worker.
VULTR_JUDGE_MODEL=

# Managed PostgreSQL (pgvector-capable). Only the proxy process uses this. Never give it to the sandbox.
DATABASE_URL=postgresql://user:password@host:5432/defaultdb?sslmode=require

# Memory quarantine
GATE_MODE=gated
# URL the sandbox uses to reach the proxy. Must be reachable from inside a Microsandbox microVM.
PROXY_BASE_URL=http://localhost:8000
# Domains that external emails and URLs may reference without a POLICY_BLOCKED hit (comma-separated).
ALLOWED_DOMAINS=roastery-co.example

# Sandbox limits (applied to every run)
SANDBOX_IMAGE=python
SANDBOX_CPUS=1
SANDBOX_MEMORY_MIB=512
SANDBOX_MAX_DURATION_S=60
SANDBOX_EXEC_TIMEOUT_S=30
MAX_ATTEMPTS=3

# Reviewer and demo routes (/ui, /audit, /demo/runs) require this token (?token= or X-Review-Token).
REVIEW_TOKEN=
