# Copy to infra/.env (git-ignored). Placeholders only; never commit real values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=quarantine
POSTGRES_PORT=5432
PROXY_DB_PASSWORD=change-me-proxy
READER_DB_PASSWORD=change-me-reader
# Local: host=localhost. Vultr Managed PG: its host and port, with ?sslmode=require
DATABASE_URL_PROXY=postgresql://quarantine_proxy:change-me-proxy@localhost:5432/quarantine
DATABASE_URL_READER=postgresql://memory_reader:change-me-reader@localhost:5432/quarantine

# Local MinIO: http://localhost:9000. Vultr: https://<region>.vultrobjects.com
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=quarantine-receipts

VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=your-inference-key
JUDGE_MODEL=qwen3.8-27b
JUDGE_MODEL_FALLBACK=qwen3.8-flash-next:free
EMBED_MODEL=qwen3-embedding-4b
EMBED_DIMENSIONS=1024

HOST_SECRET=change-me-host-secret
REVIEWER_TOKEN=change-me-reviewer-token
RECEIPT_SIGNING_KEY_PATH=infra/keys/receipt_ed25519.pem
DEMO_ALLOW_NAIVE=false
# Comma-separated hostnames the sandbox may reach
EGRESS_ALLOWLIST=
# Vultr API key, used by vultr_provision.sh only
VULTR_API_KEY=your-vultr-api-key
